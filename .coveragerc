[run]
# Line coverage answers "did this run?"; branch coverage answers "did both ways run?".
# A gate at 100% lines can still miss the arm that never fired — the `if` that was only
# ever entered, the `for` that never ran dry — which is where the interesting bugs sit.
branch = true
omit =
    plugin/scripts/release.sh

[report]
exclude_also =
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    raise NotImplementedError
    pragma: no cover
show_missing = true
